{
  "name": "errandd",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "bun run app/index.ts",
    "telegram": "bun run app/index.ts telegram",
    "discord": "bun run app/index.ts discord",
    "status": "bun run app/index.ts status",
    "test": "bun test",
    "bump:plugin-version": "bun run scripts/bump-plugin-version.ts",
    "bump:marketplace-version": "bun run scripts/bump-marketplace-version.ts",
    "lint": "mise exec -- biome check . && bun run lint:eslint",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:fix": "mise exec -- biome check --write . && eslint . --fix",
    "format": "mise exec -- biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "build:web": "bun run web/build.ts",
    "build:web:ensure": "bun run scripts/ensure-web-build.ts",
    "dev:web": "bun --watch web/build.ts",
    "setup:sqlite-zstd": "bun run scripts/setup-sqlite-zstd.ts",
    "compact:sqlite": "bun run scripts/compact-sqlite.ts",
    "test:upgrade": "ERRANDD_REQUIRE_SQLITE_ZSTD=1 bun test app/__tests__/sqlite-upgrade.test.ts"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.8.5",
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.62.0",
    "@html-eslint/parser": "^0.62.0",
    "@tailwindcss/cli": "^4.3.0",
    "@types/bun": "^1.3.9",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "daisyui": "^5.5.20",
    "eslint": "^10.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "unified": "^11.0.5"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@assistant-ui/react": "^0.15.31",
    "@assistant-ui/react-ag-ui": "^0.1.0",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-prometheus": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shikijs/langs": "1.29.2",
    "@shikijs/themes": "1.29.2",
    "@uiw/react-codemirror": "^4.25.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cronstrue": "^3.14.0",
    "diff": "^9.0.0",
    "lucide-react": "^0.556.0",
    "marked": "^15.0.0",
    "ogg-opus-decoder": "^1.7.3",
    "react": "^19.2.6",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.2.6",
    "react-json-view-lite": "^2.5.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "shiki": "^1.29.2",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.1",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  }
}
